{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framecue.dev/schemas/framecue-package-v2.schema.json",
  "title": "FrameCue package v2",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "revision",
    "viewer_version",
    "content_checksum",
    "workflow",
    "subtitle_policy",
    "scenes",
    "cues",
    "blocks",
    "lineage"
  ],
  "properties": {
    "schema_version": { "const": "framecue_package_v2" },
    "review_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "string", "pattern": "^r[1-9][0-9]*$" },
    "viewer_version": { "type": "string", "minLength": 1 },
    "content_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string" },
    "workflow": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["subtitle", "redraw", "boundary", "hyperframes", "image_carousel", "markdown", "paper_edit"] },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "subtitle_policy": {
      "type": "object",
      "required": ["display_punctuation", "speech_punctuation"],
      "properties": {
        "display_punctuation": { "type": "string" },
        "speech_punctuation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "object",
      "properties": {
        "video": {
          "type": "object",
          "required": ["src", "captions"],
          "properties": {
            "src": { "type": "string", "minLength": 1 },
            "captions": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "carousel": {
          "type": "object",
          "required": ["contact_sheet", "mobile_audit"],
          "properties": {
            "contact_sheet": { "type": "string", "minLength": 1 },
            "mobile_audit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "markdown": {
          "type": "object",
          "required": ["source_name", "frontmatter", "editorial_notes"],
          "properties": {
            "source_name": { "type": "string" },
            "frontmatter": { "type": "string" },
            "editorial_notes": { "type": "string" }
          },
          "additionalProperties": true
        },
        "paper_edit": {
          "type": "object",
          "required": ["sources"],
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "src"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                  "src": { "type": "string", "minLength": 1 },
                  "label": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cue" }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    "risks": { "type": "array", "items": { "type": "object" } },
    "provenance": { "type": "object" },
    "lineage": {
      "type": "object",
      "required": ["previous_package_checksum", "previous_result"],
      "properties": {
        "previous_package_checksum": { "type": "string" },
        "previous_result": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "milliseconds": { "type": "integer", "minimum": 0 },
    "scene": {
      "type": "object",
      "required": ["id", "start_ms", "end_ms", "image"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start_ms": { "$ref": "#/$defs/milliseconds" },
        "end_ms": { "$ref": "#/$defs/milliseconds" },
        "image": { "type": "string" },
        "redraw": { "type": "object" },
        "boundary": { "type": "object" }
      },
      "additionalProperties": true
    },
    "cue": {
      "type": "object",
      "required": ["id", "start_ms", "end_ms", "scene_id", "text", "speech_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start_ms": { "$ref": "#/$defs/milliseconds" },
        "end_ms": { "$ref": "#/$defs/milliseconds" },
        "scene_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "speech_text": { "type": "string" },
        "original_text": { "type": "string" },
        "audio": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "boundary": { "type": "object" },
        "markdown": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["paragraph", "heading", "list"] }
          },
          "additionalProperties": true
        },
        "beat": {
          "type": "object",
          "required": ["teaching_purpose", "spoken_content_summary", "narration_spine", "source_ranges", "visual_slots", "duration_ms", "unresolved_work"],
          "properties": {
            "teaching_purpose": { "type": "string" },
            "spoken_content_summary": { "type": "string" },
            "narration_spine": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" },
                    "production_method": { "type": "string", "minLength": 1 },
                    "duration": { "type": "string", "minLength": 1 },
                    "acceptance": { "type": "string", "minLength": 1 },
                    "source_id": { "type": "string" },
                    "start_ms": { "$ref": "#/$defs/milliseconds" },
                    "end_ms": { "$ref": "#/$defs/milliseconds" }
                  },
                  "additionalProperties": true
                }
              ]
            },
            "source_ranges": { "type": "array", "items": { "$ref": "#/$defs/paper_edit_slot" } },
            "visual_slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paper_edit_slot" } },
            "duration_ms": { "$ref": "#/$defs/milliseconds" },
            "unresolved_work": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "required": ["id", "cue_ids", "start_ms", "end_ms", "source_text", "target_text", "speech_text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cue_ids": { "type": "array", "items": { "type": "string" } },
        "start_ms": { "$ref": "#/$defs/milliseconds" },
        "end_ms": { "$ref": "#/$defs/milliseconds" },
        "source_text": { "type": "string" },
        "target_text": { "type": "string" },
        "speech_text": { "type": "string" },
        "budget_ms": { "$ref": "#/$defs/milliseconds" }
      },
      "additionalProperties": true
    },
    "paper_edit_slot": {
      "type": "object",
      "required": ["availability", "role"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "production_method": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "start_ms": { "$ref": "#/$defs/milliseconds" },
        "end_ms": { "$ref": "#/$defs/milliseconds" },
        "availability": { "enum": ["existing", "planned", "gap"] },
        "role": { "enum": ["evidence", "illustration", "reference-only"] }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "existing" } }, "required": ["availability"] },
          "then": { "required": ["source_id", "start_ms", "end_ms"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["source_id"] },
                { "required": ["start_ms"] },
                { "required": ["end_ms"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "role": { "const": "evidence" } }, "required": ["role"] },
          "then": { "properties": { "availability": { "const": "existing" } }, "required": ["availability"] }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
