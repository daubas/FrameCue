{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framecue.dev/schemas/framecue-manifest-v2.schema.json",
  "title": "FrameCue manifest v2",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "framecue_manifest_v2" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "review_package"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "label": { "type": "string" },
          "review_package": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
